class Solution(object):
    def lengthOfLongestSubstring(self, s):
        seen = {}
        left = 0
        longest = 0

        for right in range(len(s)):
            char = s[right]

            if char in seen and seen[char] >= left:
                left = seen[char] + 1

            seen[char] = right

            length = right - left + 1

            if length > longest:
                longest = length

        return longest
